{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "4xd-website",
  "compatibility_date": "2026-10-20",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The feedback API and download counting run the Worker; everything else is served straight from public/.
    "run_worker_first": ["/api/*", "/downloads/*"],
    "not_found_handling": "404-page"
  },
  // No database_id: Wrangler creates the database on first deploy and keeps it linked.
  "d1_databases": [{ "binding": "DB", "database_name": "4xd-feedback" }],
  "observability": { "enabled": true }
}
